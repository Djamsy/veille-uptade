# =====================================================
#  .env.example — racine
#  Pour le frontend Next.js et les scripts à la racine.
#  Copier en .env (jamais committé).
# =====================================================

# --- Frontend Next.js (préfixe NEXT_PUBLIC_ = exposé au navigateur) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# --- Optionnel : forcer un thème UI ------------------
# Valeurs : carte | classic
NEXT_PUBLIC_UI=carte
