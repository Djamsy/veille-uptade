# ========== INCLUSION ROBUSTE DES ROUTERS ==========

def include_router_safely(candidates: List[str], attr_name: str, prefix: str = "") -> bool:
    """Inclut un router de manière robuste"""
    last_err = None
    
    for module_path in candidates:
        try:
            if module_path.startswith("backend."):
                backend_dir = os.path.join(os.path.dirname(__file__))
                if backend_dir not in sys.path:
                    sys.path.insert(0, backend_dir)
            
            module = __import__(module_path, fromlist=[attr_name])
            
            if not hasattr(module, attr_name):
                continue
            
            router = getattr(module, attr_name)
            
            eff_prefix = prefix
            if hasattr(router, 'prefix') and router.prefix:
                if prefix and router.prefix.startswith(prefix):
                    eff_prefix = ""
                elif not prefix:
                    eff_prefix = ""

            app.include_router(router, prefix=eff_prefix)
            logger.info(f"✅ Router '{attr_name}' importé depuis {module_path}")
            return True

        except Exception as e:
            last_err = e

    logger.warning(f"⚠️ Router '{attr_name}' non chargé depuis {candidates}")
    return False

# ========== INCLUSION DES ROUTES MODULAIRES ==========

