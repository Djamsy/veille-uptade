@app.post("/api/scraper/manual")
async def scrape_articles_now():
    """Lancer le scraping d'articles immédiatement"""
    if not guadeloupe_scraper:
        raise HTTPException(status_code=500, detail="Scraper non disponible")
    
    try:
        logger.info("🚀 Scraping manuel lancé...")
        
        if hasattr(guadeloupe_scraper, 'scrape_all_sites'):
            result = guadeloupe_scraper.scrape_all_sites()
        elif hasattr(guadeloupe_scraper, 'run'):
            result = guadeloupe_scraper.run()
        else:
            raise HTTPException(status_code=500, detail="Méthode de scraping non trouvée")
        
        # Lancer détection après scraping
        if result.get("success"):
            detection = await detect_affairs_now()
            result["affairs_detected"] = detection.get("affairs_created", 0)
        
        return {
            "success": True,
            "message": "Scraping terminé",
            "result": result,
            "timestamp": datetime.now().isoformat()
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"❌ Erreur scraping: {e}")
        raise HTTPException(status_code=500, detail=str(e))

