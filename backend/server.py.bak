include_router_safely(["backend.transcription_routes", "transcription_routes"], "router", prefix="/api")
include_router_safely(["backend.transcription_ai_routes", "transcription_ai_routes"], "router")
include_router_safely(["backend.radio_cards_routes", "radio_cards_routes"], "router", prefix="/api")
