@app.on_event("startup")
async def on_startup():
    """Événements au démarrage"""
    logger.info("=" * 60)
    logger.info(f"DÉMARRAGE SERVEUR VEILLE MÉDIA V{VERSION}")
    logger.info(f"Logique d'affaires + BMG + Sentiment IA activée")
    logger.info(f"Gravité min: {GRAVITY_THRESHOLD}")
    logger.info("=" * 60)
    
    if mongo_client:
        try:
            articles_count = collections['articles_guadeloupe'].count_documents({})
            affairs_count = collections['affairs'].count_documents({})
            logger.info(f"📊 Base: {articles_count} articles, {affairs_count} affaires")
        except:
            pass
    
    if RUN_SCHEDULER and callable(start_scheduler_func):
        try:
            start_scheduler_func(app)
            logger.info("🗓️ Scheduler démarré")
            
            from apscheduler.triggers.cron import CronTrigger
            scheduler = app.state.scheduler
            
            # Job 1: Détection affaires (xx:05)
            scheduler.add_job(
                scheduled_detect_affairs,
                CronTrigger(minute=5, hour="*"),
                id="detect_affairs_hourly",
                replace_existing=True
            )
            logger.info("✅ Job 'detect_affairs_hourly' programmé (xx:05)")
            
            # Job 2: Mise à jour affaires (*/10)
            scheduler.add_job(
                scheduled_update_affairs,
                CronTrigger(minute="*/10"),
                id="update_affairs_regularly",
                replace_existing=True
            )
            logger.info("✅ Job 'update_affairs_regularly' programmé (*/10)")
            
            # Job 3: Calcul BMG (xx:30)
            scheduler.add_job(
                scheduled_calculate_bmg,
                CronTrigger(minute=30, hour="*"),
                id="calculate_bmg_hourly",
                replace_existing=True
            )
            logger.info("✅ Job 'calculate_bmg_hourly' programmé (xx:30)")
            
        except Exception as e:
            logger.warning(f"⚠️ Jobs affaires: {e}")
    
    logger.info("=" * 60)
    logger.info("✅ Système prêt avec détection automatique intelligente")
    logger.info("=" * 60)

@app.on_event("shutdown")
def shutdown_event():
    """Nettoyage à l'arrêt"""
    if mongo_client:
        try:
            mongo_client.close()
            logger.info("🗃️ MongoDB fermé")
        except:
            pass
    logger.info("👋 Arrêt terminé")

# ========== GESTION D'ERREURS ==========

@app.exception_handler(HTTPException)
async def http_exception_handler(request: Request, exc: HTTPException):
    return JSONResponse(
        status_code=exc.status_code,
        content={
            "success": False,
            "error": exc.detail,
            "status_code": exc.status_code,
            "path": str(request.url.path),
            "timestamp": datetime.now().isoformat()
        }
    )

@app.exception_handler(Exception)
async def general_exception_handler(request: Request, exc: Exception):
    logger.error(f"❌ Erreur non gérée: {exc}", exc_info=True)
    return JSONResponse(
        status_code=500,
        content={
            "success": False,
            "error": "Erreur interne du serveur",
            "detail": str(exc) if ENVIRONMENT == "development" else "Erreur interne",
            "path": str(request.url.path),
            "timestamp": datetime.now().isoformat()
        }
    )

# ========== DÉMARRAGE ==========

if __name__ == "__main__":
    uvicorn.run(
        "backend.server:app",
        host="0.0.0.0",
        port=8000,
        reload=True if ENVIRONMENT == "development" else False,
        log_level="info"
    )