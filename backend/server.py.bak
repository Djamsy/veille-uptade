@app.get("/api/affairs/{affair_id}")
async def get_affair_detail(affair_id: str):
    """Détail complet d'une affaire avec BMG"""
    try:
        affair = collections['affairs'].find_one({"affair_id": affair_id})
        
        if not affair:
            raise HTTPException(status_code=404, detail="Affaire non trouvée")
        
        # Récupérer articles liés
        article_ids = []
        for aid in affair.get("articles", []):
            try:
                article_ids.append(ObjectId(aid))
            except:
                pass
        
        if article_ids:
            articles = list(collections['articles_guadeloupe'].find({
                "_id": {"$in": article_ids}
            }))
            affair["linked_articles"] = [serialize_doc(a) for a in articles]
        else:
            affair["linked_articles"] = []
        
        # Calculer BMG si pas déjà fait
        if not affair.get('bruit_numerique'):
            bmg_data = calculate_bruit_numerique(affair)
            collections['affairs'].update_one(
                {"_id": affair["_id"]},
                {"$set": {"bruit_numerique": bmg_data}}
            )
            affair['bruit_numerique'] = bmg_data
        
        return serialize_doc(affair)
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"❌ Erreur détail affaire: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/affairs/{affair_id}/calculate-bmg")
async def calculate_affair_bmg(affair_id: str):
    """Calcule/recalcule le BMG d'une affaire"""
    try:
        affair = collections['affairs'].find_one({"affair_id": affair_id})
        
        if not affair:
            raise HTTPException(status_code=404, detail="Affaire non trouvée")
        
        bmg_data = calculate_bruit_numerique(affair)
        
        collections['affairs'].update_one(
            {"_id": affair["_id"]},
            {"$set": {"bruit_numerique": bmg_data}}
        )
        
        return {
            "success": True,
            "affair_id": affair_id,
            "bruit_numerique": bmg_data
        }
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"❌ Erreur calcul BMG: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/update-affairs")
async def update_affairs_with_new_content():
    """Met à jour les affaires avec nouveaux contenus"""
    try:
        affairs = list(collections['affairs'].find({"status": {"$in": ["active", "critical"]}}))
        
        if not affairs:
            return {"success": True, "message": "Aucune affaire active"}
        
        cutoff = datetime.now() - timedelta(hours=2)
        updated_count = 0
        
        for affair in affairs:
            keywords = affair.get("keywords", [])
            entities = affair.get("entities", [])
            
            existing_ids = []
            for aid in affair.get("articles", []):
                try:
                    existing_ids.append(ObjectId(aid))
                except:
                    pass
            
            query = {
                "scraped_at": {"$gte": cutoff.isoformat()},
                "_id": {"$nin": existing_ids}
            }
            
            new_articles = []
            for article in collections['articles_guadeloupe'].find(query).limit(10):
                title = article.get("title", "").lower()
                article_entities = article.get("entites", []) or article.get("entites_detectees", [])
                
                # Vérifier temporalité
                article_date = article.get('date', '')
                affair_date = affair.get('created_at', '')
                temporal_score = calculate_temporal_similarity(article_date, affair_date)
                
                if temporal_score < 0.4:
                    continue
                
                if (any(e in article_entities for e in entities) or
                    any(kw in title for kw in keywords)):
                    new_articles.append(str(article["_id"]))
            
            if new_articles:
                collections['affairs'].update_one(
                    {"_id": affair["_id"]},
                    {
                        "$addToSet": {"articles": {"$each": new_articles}},
                        "$set": {"last_updated": datetime.now().isoformat()},
                        "$inc": {
                            "article_count": len(new_articles),
                            "buzz_score": len(new_articles) * 10
                        }
                    }
                )
                updated_count += 1
                logger.info(f"📈 Mise à jour: {affair['title']} (+{len(new_articles)})")
        
        return {
            "success": True,
            "message": f"{updated_count} affaires mises à jour",
            "timestamp": datetime.now().isoformat()
        }
        
    except Exception as e:
        logger.error(f"❌ Erreur mise à jour: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/affairs/stats")
async def get_affairs_stats():
    """Statistiques sur les affaires"""
    try:
        total = collections['affairs'].count_documents({})
        critical = collections['affairs'].count_documents({"status": "critical"})
        active = collections['affairs'].count_documents({"status": "active"})
        high_gravity = collections['affairs'].count_documents({"gravity_score": {"$gte": 0.8}})
        
        pipeline = [
            {"$unwind": "$entities"},
            {"$group": {"_id": "$entities", "count": {"$sum": 1}}},
            {"$sort": {"count": -1}},
            {"$limit": 10}
        ]
        
        try:
            top_entities = list(collections['affairs'].aggregate(pipeline))
        except:
            top_entities = []
        
        return {
            "success": True,
            "stats": {
                "total": total,
                "critical": critical,
                "active": active,
                "high_gravity": high_gravity,
                "gravity_threshold": GRAVITY_THRESHOLD
            },
            "top_entities": [{"entity": e["_id"], "count": e["count"]} for e in top_entities]
        }
        
    except Exception as e:
        logger.error(f"❌ Erreur stats: {e}")
        raise HTTPException(status_code=500, detail=str(e))

