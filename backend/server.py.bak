async def scheduled_calculate_bmg():
    """Job: calcul BMG pour affaires actives"""
    try:
        logger.info("📊 [SCHEDULED] Calcul BMG")
        
        active_affairs = list(collections['affairs'].find({
            "status": {"$in": ["active", "critical"]}
        }))
        
        updated = 0
        for affair in active_affairs:
            try:
                bmg_data = calculate_bruit_numerique(affair)
                collections['affairs'].update_one(
                    {"_id": affair["_id"]},
                    {"$set": {"bruit_numerique": bmg_data}}
                )
                
                # Sauvegarder dans l'historique
                bmg_history_entry = {
                    **bmg_data,
                    'affair_id': affair.get('affair_id'),
                    'affair_title': affair.get('title')
                }
                collections['bmg_history'].insert_one(bmg_history_entry)
                
                updated += 1
            except Exception as e:
                logger.warning(f"⚠️ BMG échec pour {affair.get('affair_id')}: {e}")
        
        logger.info(f"✅ BMG calculé pour {updated}/{len(active_affairs)} affaires")
        
    except Exception as e:
        logger.error(f"❌ Erreur scheduled BMG: {e}")

