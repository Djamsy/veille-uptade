# ========== PONDÉRATIONS BRUIT NUMÉRIQUE ==========

# Pondérations par canal (poids global)
CANAL_WEIGHTS = {
    'radio': 0.35,
    'television': 0.30,
    'presse': 0.25,
    'reseaux_sociaux': 0.10  # 0.25 en cas de crise
}

# Pondérations RADIO (locale)
RADIO_WEIGHTS = {
    'RCI': 1.0,
    'Guadeloupe La 1ère': 0.8,
    'NRJ Antilles': 0.4,
    'TRACE FM': 0.35,
    'BEL': 0.2,
    'MFM': 0.2
}

# Pondérations TÉLÉVISION
TV_WEIGHTS = {
    'Guadeloupe La 1ère': 1.0,
    'France 2': 0.4,
    'Canal+': 0.35,
    'France 3': 0.25,
    'France Info': 0.15
}

# Pondérations PRESSE NUMÉRIQUE
PRESSE_WEIGHTS = {
    'France-Antilles': 1.0,
    'RCI': 0.9,
    'Outremers360': 0.8,
    'La 1ère': 0.7,
    'KaribInfo': 0.65,
    'Bondamanjak': 0.6,
    'DROM-COM': 0.5
}

# Pondérations RÉSEAUX SOCIAUX
RS_WEIGHTS = {
    'institutionnel': 1.0,
    'medias_etablis': 0.8,
    'influenceurs_diaspora': 0.6,
    'youtube_satirique': 0.5,
    'facebook_groupes': 0.4,
    'tiktok_reels': 0.3,
    'twitter_x': 0.25,
    'reddit_forums': 0.2
}

# ========== ANALYSE DE SENTIMENT ==========

def analyze_sentiment_for_item(text: str, item_type: str = "article") -> Dict[str, Any]:
    """
    Analyse le sentiment d'un texte (article, transcription, post social)
    Utilise le service unifié (local ou GPT)
    """
    if not sentiment_service or not text:
        return {
            'sentiment': 'neutral',
            'score': 0.0,
            'confidence': 0.0,
            'method': 'default'
        }
    
    try:
        # Utiliser GPT pour contenus importants (>300 chars), sinon local
        use_gpt = len(text) > 300 and sentiment_service.gpt.available
        
        result = sentiment_service.analyze(text, use_gpt=use_gpt)
        
        # Normaliser pour compatibilité
        return {
            'sentiment': result['polarity'],
            'score': result['score'],
            'confidence': result.get('confidence', 0.7),
            'intensity': result.get('intensity', 'moderate'),
            'method': result.get('method', 'local')
        }
        
    except Exception as e:
        logger.error(f"Erreur analyse sentiment: {e}")
        return {
            'sentiment': 'neutral',
            'score': 0.0,
            'confidence': 0.0,
            'method': 'error'
        }

# ========== CALCUL BRUIT NUMÉRIQUE ==========

def calculate_engagement_score(item: Dict, canal_type: str) -> float:
    """Calcule le score d'engagement selon le type de canal"""
    
    if canal_type == 'radio':
        # Pour radio: durée d'antenne
        duration = item.get('duration_seconds', 0)
        return min(1.0, duration / 300)  # Normaliser sur 5 minutes
    
    elif canal_type == 'television':
        # Pour TV: durée + heure de diffusion
        duration = item.get('duration_seconds', 0)
        prime_time = item.get('prime_time', False)
        base = min(1.0, duration / 600)  # Normaliser sur 10 minutes
        return base * 1.5 if prime_time else base
    
    elif canal_type == 'presse':
        # Pour presse: position + longueur
        is_headline = item.get('is_headline', False)
        word_count = item.get('word_count', 0)
        base = min(1.0, word_count / 500)
        return base * 2.0 if is_headline else base
    
    elif canal_type == 'reseaux_sociaux':
        # Pour RS: engagement TikTok style
        shares = item.get('shares', 0)
        comments = item.get('comments', 0)
        likes = item.get('likes', 0)
        views = item.get('views', 1)
        
        engagement_total = (3 * shares) + (2 * comments) + likes
        engagement_normalized = (engagement_total / views) * 100 if views > 0 else 0
        
        return min(1.0, engagement_normalized / 10)
    
    return 0.5

def get_media_weight(source: str, canal_type: str, item: Dict = None) -> float:
    """Retourne la pondération d'un média selon le canal"""
    
    source_lower = source.lower()
    
    if canal_type == 'radio':
        for media, weight in RADIO_WEIGHTS.items():
            if media.lower() in source_lower:
                return weight
        return 0.2
    
    elif canal_type == 'television':
        for media, weight in TV_WEIGHTS.items():
            if media.lower() in source_lower:
                return weight
        return 0.15
    
    elif canal_type == 'presse':
        for media, weight in PRESSE_WEIGHTS.items():
            if media.lower() in source_lower:
                return weight
        return 0.5
    
    elif canal_type == 'reseaux_sociaux':
        if item:
            if item.get('is_institutional'):
                return RS_WEIGHTS['institutionnel']
            elif item.get('is_media'):
                return RS_WEIGHTS['medias_etablis']
            elif item.get('is_influencer'):
                return RS_WEIGHTS['influenceurs_diaspora']
        
        if 'facebook' in source_lower:
            return RS_WEIGHTS['facebook_groupes']
        elif 'tiktok' in source_lower:
            return RS_WEIGHTS['tiktok_reels']
        elif 'twitter' in source_lower or 'x.com' in source_lower:
            return RS_WEIGHTS['twitter_x']
        else:
            return 0.3
    
    return 0.5

def calculate_bruit_numerique(affair: Dict) -> Dict[str, Any]:
    """
    Calcule le Bruit Numérique Global (BMG) pour une affaire
    
    BMG = Σ(BNPi × Pi) / ΣPi
    BNPi = (V × E × S) / 100
    
    V = Volume de mentions
    E = Engagement (score selon canal)
    S = Sentiment (-1 à +1)
    P = Pondération (poids du média/canal)
    """
    
    article_ids = affair.get('articles', [])
    radio_ids = affair.get('radio_transcriptions', [])
    social_ids = affair.get('social_posts', [])
    
    canal_scores = {
        'radio': {'bnp_sum': 0, 'weight_sum': 0, 'count': 0},
        'television': {'bnp_sum': 0, 'weight_sum': 0, 'count': 0},
        'presse': {'bnp_sum': 0, 'weight_sum': 0, 'count': 0},
        'reseaux_sociaux': {'bnp_sum': 0, 'weight_sum': 0, 'count': 0}
    }
    
    # === TRAITER ARTICLES (PRESSE) ===
    if article_ids:
        try:
            obj_ids = [ObjectId(aid) for aid in article_ids if aid]
            articles = list(collections['articles_guadeloupe'].find({'_id': {'$in': obj_ids}}))
            
            for article in articles:
                volume = 1
                engagement = calculate_engagement_score(article, 'presse')
                
                # Sentiment (utiliser cache ou analyser)
                sentiment_score = article.get('sentiment_score')
                if sentiment_score is None:
                    text = f"{article.get('title', '')} {article.get('content', '')[:300]}"
                    sentiment_data = analyze_sentiment_for_item(text, 'article')
                    sentiment_score = sentiment_data['score']
                    
                    # Sauvegarder pour cache
                    collections['articles_guadeloupe'].update_one(
                        {'_id': article['_id']},
                        {'$set': {
                            'sentiment_score': sentiment_score,
                            'sentiment': sentiment_data['sentiment']
                        }}
                    )
                
                source = article.get('source', '')
                media_weight = get_media_weight(source, 'presse')
                
                bnp = (volume * engagement * sentiment_score) / 100
                
                canal_scores['presse']['bnp_sum'] += bnp * media_weight
                canal_scores['presse']['weight_sum'] += media_weight
                canal_scores['presse']['count'] += 1
                
        except Exception as e:
            logger.error(f"Erreur calcul presse: {e}")
    
    # === TRAITER RADIO ===
    if radio_ids:
        try:
            obj_ids = [ObjectId(rid) for rid in radio_ids if rid]
            radios = list(collections['radio_transcriptions'].find({'_id': {'$in': obj_ids}}))
            
            for radio in radios:
                volume = 1
                engagement = calculate_engagement_score(radio, 'radio')
                
                sentiment_score = radio.get('sentiment_score')
                if sentiment_score is None:
                    text = radio.get('transcription_text', '')[:500]
                    sentiment_data = analyze_sentiment_for_item(text, 'radio')
                    sentiment_score = sentiment_data['score']
                    
                    collections['radio_transcriptions'].update_one(
                        {'_id': radio['_id']},
                        {'$set': {
                            'sentiment_score': sentiment_score,
                            'sentiment': sentiment_data['sentiment']
                        }}
                    )
                
                source = radio.get('stream_name', '')
                media_weight = get_media_weight(source, 'radio')
                
                bnp = (volume * engagement * sentiment_score) / 100
                
                canal_scores['radio']['bnp_sum'] += bnp * media_weight
                canal_scores['radio']['weight_sum'] += media_weight
                canal_scores['radio']['count'] += 1
                
        except Exception as e:
            logger.error(f"Erreur calcul radio: {e}")
    
    # === TRAITER RÉSEAUX SOCIAUX ===
    if social_ids:
        try:
            obj_ids = [ObjectId(sid) for sid in social_ids if sid]
            socials = list(collections['social_media_posts'].find({'_id': {'$in': obj_ids}}))
            
            for social in socials:
                volume = 1
                engagement = calculate_engagement_score(social, 'reseaux_sociaux')
                
                sentiment_score = social.get('sentiment_score')
                if sentiment_score is None:
                    text = social.get('content', '')[:500]
                    sentiment_data = analyze_sentiment_for_item(text, 'social')
                    sentiment_score = sentiment_data['score']
                    
                    collections['social_media_posts'].update_one(
                        {'_id': social['_id']},
                        {'$set': {
                            'sentiment_score': sentiment_score,
                            'sentiment': sentiment_data['sentiment']
                        }}
                    )
                
                source = social.get('platform', '')
                media_weight = get_media_weight(source, 'reseaux_sociaux', social)
                
                bnp = (volume * engagement * sentiment_score) / 100
                
                canal_scores['reseaux_sociaux']['bnp_sum'] += bnp * media_weight
                canal_scores['reseaux_sociaux']['weight_sum'] += media_weight
                canal_scores['reseaux_sociaux']['count'] += 1
                
        except Exception as e:
            logger.error(f"Erreur calcul RS: {e}")
    
    # === CALCULER BMG GLOBAL ===
    bmg_total = 0
    total_weight = 0
    canal_details = {}
    
    is_crisis = affair.get('gravity_score', 0) > 0.85
    rs_weight = 0.25 if is_crisis else CANAL_WEIGHTS['reseaux_sociaux']
    
    adjusted_weights = {
        'radio': CANAL_WEIGHTS['radio'],
        'television': CANAL_WEIGHTS['television'],
        'presse': CANAL_WEIGHTS['presse'],
        'reseaux_sociaux': rs_weight
    }
    
    for canal, data in canal_scores.items():
        if data['weight_sum'] > 0:
            canal_bmg = data['bnp_sum'] / data['weight_sum']
            canal_weight = adjusted_weights[canal]
            
            bmg_total += canal_bmg * canal_weight
            total_weight += canal_weight
            
            canal_details[canal] = {
                'bmg': round(canal_bmg, 3),
                'mentions': data['count'],
                'weight': canal_weight
            }
    
    bmg_global = bmg_total / total_weight if total_weight > 0 else 0
    
    # Interprétation
    if bmg_global > 3:
        interpretation = "forte_visibilite_positive"
    elif bmg_global > 1:
        interpretation = "bruit_maitrise"
    elif bmg_global > -1:
        interpretation = "bruit_mitige"
    elif bmg_global > -3:
        interpretation = "bruit_critique"
    else:
        interpretation = "crise_numerique"
    
    return {
        'bmg_global': round(bmg_global, 3),
        'interpretation': interpretation,
        'is_crisis': is_crisis,
        'canal_details': canal_details,
        'total_mentions': sum(d['count'] for d in canal_scores.values()),
        'calculated_at': datetime.now().isoformat()
    }

# ========== FONCTION DB HELPER ==========

def get_db():
    """Retourne la base de données MongoDB"""
    if db is None:
        raise HTTPException(status_code=500, detail="Base de données non disponible")
    return db

# ========== FONCTIONS UTILITAIRES ==========

def serialize_doc(doc: Dict[str, Any]) -> Dict[str, Any]:
    """Sérialise un document MongoDB pour l'API"""
    out = dict(doc)
    if "_id" in out:
        out["_id"] = str(out["_id"])
    for k in ("scraped_at", "published_at", "captured_at", "created_at", "last_updated"):
        if k in out and out[k] is not None:
            out[k] = out[k].isoformat() if hasattr(out[k], 'isoformat') else out[k]
    return out

def clean_title(title: str) -> str:
    """Nettoie un titre d'article"""
    title = re.sub(r'^\d+', '', title)
    title = re.sub(r'\([^)]*\)', '', title)
    title = re.sub(r'([a-z])([A-Z])', r'\1 \2', title)
    title = re.sub(r'([a-zA-Z])(\d)', r'\1 \2', title)
    title = re.sub(r'\s+', ' ', title).strip()
    title = title.rstrip('.')
    return title

# ========== LOGIQUE D'AFFAIRES AVEC TEMPORALITÉ ==========

def calculate_temporal_similarity(date1: Union[str, datetime], date2: Union[str, datetime]) -> float:
    """Calcule la similarité temporelle entre deux dates"""
    try:
        d1 = datetime.fromisoformat(date1) if isinstance(date1, str) else date1
        d2 = datetime.fromisoformat(date2) if isinstance(date2, str) else date2
        
        diff_days = abs((d1 - d2).days)
        
        if diff_days == 0:
            return 1.0
        elif diff_days <= 1:
            return 0.9
        elif diff_days <= 3:
            return 0.7
        elif diff_days <= 7:
            return 0.4
        elif diff_days <= 14:
            return 0.2
        else:
            return 0.0
            
    except:
        return 0.5

def find_similar_affair(new_articles: List[Dict], collections) -> Optional[Dict]:
    """Trouve une affaire existante similaire en tenant compte de la temporalité"""
    if not new_articles:
        return None
    
    # Date moyenne des nouveaux articles
    dates = []
    for article in new_articles:
        date_str = article.get('date') or article.get('scraped_at')
        if date_str:
            try:
                if isinstance(date_str, str):
                    dates.append(datetime.fromisoformat(date_str.split('T')[0]))
                elif isinstance(date_str, datetime):
                    dates.append(date_str)
            except:
                pass
    
    avg_date = dates[len(dates) // 2] if dates else datetime.now()
    
    # Extraire entités et mots-clés
    entities = set()
    keywords = set()
    
    for article in new_articles:
        # Utiliser les entités validées par le nouveau ai_service
        article_entities = article.get('entites', []) or article.get('entites_detectees', [])
        for e in article_entities:
            if e and e not in ['Aucune', 'France', 'Région', 'Guadeloupe']:
                entities.add(e.lower())
        
        title = article.get('title', '')
        words = [w.lower() for w in title.split() if len(w) > 5]
        keywords.update(words[:5])
    
    if not entities and not keywords:
        return None
    
    # Chercher affaires dans fenêtre temporelle
    time_window_start = (avg_date - timedelta(days=7)).isoformat()
    time_window_end = (avg_date + timedelta(days=1)).isoformat()
    
    query = {
        'status': {'$in': ['active', 'critical']},
        'created_at': {
            '$gte': time_window_start,
            '$lte': time_window_end
        }
    }
    
    if entities:
        query['$or'] = [
            {'entities': {'$in': list(entities)}},
            {'keywords': {'$in': list(keywords)}}
        ]
    
    existing_affairs = list(collections['affairs'].find(query))
    
    best_match = None
    best_score = 0
    
    for existing in existing_affairs:
        score = 0
        
        # Score entités communes
        existing_entities = set(e.lower() for e in existing.get('entities', []))
        common_entities = entities & existing_entities
        score += len(common_entities) * 30
        
        # Score mots-clés communs
        existing_keywords = set(k.lower() for k in existing.get('keywords', []))
        common_keywords = keywords & existing_keywords
        score += len(common_keywords) * 10
        
        # Score temporel
        existing_date_str = existing.get('created_at', '')
        temporal_score = calculate_temporal_similarity(avg_date.isoformat(), existing_date_str)
        score += temporal_score * 50
        
        # Pénalité si trop ancien
        try:
            days_diff = abs((avg_date - datetime.fromisoformat(existing_date_str)).days)
            if days_diff > 7:
                score *= 0.3
        except:
            days_diff = 999
        
        if score > 60 and days_diff <= 3:
            if score > best_score:
                best_score = score
                best_match = existing
    
    if best_match:
        logger.info(f"✅ Match trouvé: {best_match['title']} (score: {best_score:.1f})")
    
    return best_match

def calculate_gravity_score(articles: List[Dict]) -> float:
    """Calcule le score de gravité d'un groupe d'articles"""
    if not articles:
        return 0.0
    
    scores = []
    for article in articles:
        # Utiliser le nouveau champ de l'ai_service
        score = article.get("gravite_score", article.get("importance_score", 0.3))
        
        # Bonus mots-clés critiques
        title = article.get("title", "").lower()
        content = article.get("content", "")[:500].lower()
        
        critical_words = ["meurtre", "mort", "tué", "violence", "agression", "scandale",
                         "corruption", "arrestation", "incendie", "accident", "crise", "grève"]
        
        for word in critical_words:
            if word in title or word in content:
                score = min(1.0, score + 0.1)
        
        scores.append(score)
    
    return sum(scores) / len(scores) if scores else 0.3

def extract_entities_from_articles(articles: List[Dict]) -> List[str]:
    """Extrait les entités principales des articles (validées)"""
    entities = []
    
    for article in articles:
        # Utiliser les entités validées du nouveau ai_service
        article_entities = article.get("entites", []) or article.get("entites_detectees", [])
        for e in article_entities:
            if e and e not in ["Aucune", "France", "Région", "Guadeloupe"]:
                entities.append(e)
    
    if entities:
        entity_counts = Counter(entities)
        return [e for e, count in entity_counts.most_common(3) if count > 0]
    return []

def generate_affair_title(articles: List[Dict], entities: List[str], gravity: float) -> str:
    """Génère un titre intelligent pour l'affaire"""
    
    prefix = ""
    if gravity > 0.9:
        prefix = "🔴 "
    elif gravity > 0.8:
        prefix = "⚠️ "
    
    if len(articles) == 1:
        article = articles[0]
        title = clean_title(article.get("title", ""))
        
        if '|' in title:
            title = title.split('|')[-1].strip()
        
        words = [w for w in title.split()[:8] if len(w) > 2 and not w.isdigit()]
        short_title = " ".join(words[:6])
        
        if entities and entities[0]:
            entity = entities[0].split('(')[0].strip()
            entity = entity.split(':')[0].strip()
            
            if entity.lower() not in short_title.lower():
                return f"{prefix}{entity}: {short_title}"[:80]
            else:
                return f"{prefix}{short_title}"[:80]
        else:
            return f"{prefix}{short_title}"[:80]
    
    # Pour plusieurs articles
    themes = [a.get("theme_principal", "") for a in articles]
    theme_counts = Counter(themes)
    dominant_theme = theme_counts.most_common(1)[0][0] if theme_counts else "général"
    
    if entities and entities[0]:
        theme_name = dominant_theme.replace("_", " ").title() if dominant_theme else ""
        return f"{prefix}{entities[0]} - {theme_name}".strip()[:80]
    else:
        common_words = []
        for article in articles[:3]:
            title = clean_title(article.get("title", ""))
            words = [w for w in title.split() if len(w) > 4]
            common_words.extend(words[:3])
        
        if common_words:
            word_counts = Counter(common_words)
            top_words = [w for w, _ in word_counts.most_common(3)]
            return f"{prefix}{' '.join(top_words)[:50]}".strip()
        
        return f"{prefix}Affaire {dominant_theme.title()}".strip()

def create_affair_from_articles(articles: List[Dict]) -> Optional[Dict]:
    """Crée une affaire à partir d'un groupe d'articles"""
    
    gravity = calculate_gravity_score(articles)
    
    if len(articles) == 1:
        importance = articles[0].get("importance_score", articles[0].get("gravite_score", 0))
        gravity = max(gravity, importance)
    
    if gravity < GRAVITY_THRESHOLD:
        logger.info(f"⚠️ Gravité insuffisante ({gravity:.2f} < {GRAVITY_THRESHOLD})")
        return None
    
    entities = extract_entities_from_articles(articles)
    title = generate_affair_title(articles, entities, gravity)
    
    content = f"{title}:{datetime.now().strftime('%Y%m%d')}"
    affair_id = f"AFF-{hashlib.md5(content.encode()).hexdigest()[:10].upper()}"
    
    # Extraire keywords
    keywords = set()
    for article in articles:
        title_text = article.get("title", "")
        words = [w.lower() for w in title_text.split() if len(w) > 5]
        keywords.update(words)
    
    stop_words = {"guadeloupe", "article", "nouvelle", "après", "cette", "dans", "pour",
                  "avec", "france", "région", "société", "politique"}
    keywords = list(keywords - stop_words)[:15]
    
    affair = {
        "affair_id": affair_id,
        "title": title,
        "entities": entities,
        "gravity_score": round(gravity, 2),
        "buzz_score": len(articles) * 20,
        "articles": [str(a.get("_id", "")) for a in articles if "_id" in a],
        "article_count": len(articles),
        "created_at": datetime.now().isoformat(),
        "last_updated": datetime.now().isoformat(),
        "status": "critical" if gravity > 0.8 else "active",
        "auto_created": True,
        "keywords": keywords,
        "sources": {
            "articles": len(articles),
            "radio": 0,
            "social": 0
        },
        "bruit_numerique": {}
    }
    
    return affair

# ========== ENDPOINTS D'AFFAIRES ==========

@app.post("/api/detect-affairs-now")
async def detect_affairs_now():
    """Détecte les affaires dans les articles récents"""
    try:
        logger.info("🔍 Détection d'affaires lancée manuellement")
        
        cutoff_date = (datetime.now() - timedelta(days=3)).strftime("%Y-%m-%d")
        
        articles = list(collections['articles_guadeloupe'].find({
            "date": {"$gte": cutoff_date}
        }).sort("scraped_at", -1))
        
        if not articles:
            return {
                "success": True,
                "message": "Aucun article récent à analyser",
                "affairs_created": 0
            }
        
        logger.info(f"📰 {len(articles)} articles récents à analyser")
        
        # Grouper par entité + fenêtre temporelle
        groups_by_entity_time = {}
        
        for article in articles:
            # Utiliser les entités validées du nouveau ai_service
            entities = article.get("entites", []) or article.get("entites_detectees", [])
            entity = entities[0] if entities else article.get("theme_principal", "général")
            
            if entity in ["Aucune", "France", "Région", "Guadeloupe", ""]:
                entity = article.get("theme_principal", "général")
            
            date_str = article.get("date", "")
            try:
                date_obj = datetime.strptime(date_str, "%Y-%m-%d")
                week_number = date_obj.isocalendar()[1]
                year = date_obj.year
            except:
                week_number = datetime.now().isocalendar()[1]
                year = datetime.now().year
            
            group_key = f"{entity.lower().strip()}_{year}W{week_number}"
            
            if group_key not in groups_by_entity_time:
                groups_by_entity_time[group_key] = []
            groups_by_entity_time[group_key].append(article)
        
        # Sous-diviser si écart > 3 jours
        final_groups = []
        for group in groups_by_entity_time.values():
            group.sort(key=lambda x: x.get("date", ""))
            
            current_subgroup = [group[0]]
            for article in group[1:]:
                try:
                    last_date = datetime.strptime(current_subgroup[-1].get("date"), "%Y-%m-%d")
                    curr_date = datetime.strptime(article.get("date"), "%Y-%m-%d")
                    
                    if (curr_date - last_date).days <= 3:
                        current_subgroup.append(article)
                    else:
                        final_groups.append(current_subgroup)
                        current_subgroup = [article]
                except:
                    current_subgroup.append(article)
            
            final_groups.append(current_subgroup)
        
        logger.info(f"📦 {len(final_groups)} groupes temporels formés")
        
        affairs_created = 0
        affairs_updated = 0
        affairs_rejected = 0
        
        for group in final_groups:
            if len(group) == 1:
                article = group[0]
                importance = article.get("importance_score", article.get("gravite_score", 0))
                
                if importance < 0.5:
                    continue
            
            existing = find_similar_affair(group, collections)
            
            if existing:
                new_article_ids = [str(a.get("_id")) for a in group if "_id" in a]
                collections['affairs'].update_one(
                    {"_id": existing["_id"]},
                    {
                        "$addToSet": {"articles": {"$each": new_article_ids}},
                        "$set": {"last_updated": datetime.now().isoformat()},
                        "$inc": {"article_count": len(new_article_ids), "buzz_score": len(new_article_ids) * 10}
                    }
                )
                affairs_updated += 1
                logger.info(f"📈 Mise à jour: {existing['title']}")
            else:
                affair = create_affair_from_articles(group)
                
                if affair is None:
                    affairs_rejected += 1
                    continue
                
                collections['affairs'].insert_one(affair)
                affairs_created += 1
                logger.info(f"✅ Nouvelle affaire: {affair['title']}")
        
        return {
            "success": True,
            "message": f"Détection terminée: {affairs_created} créées, {affairs_updated} mises à jour, {affairs_rejected} rejetées",
            "affairs_created": affairs_created,
            "affairs_updated": affairs_updated,
            "affairs_rejected": affairs_rejected,
            "groups_analyzed": len(final_groups),
            "timestamp": datetime.now().isoformat()
        }
        
    except Exception as e:
        logger.error(f"❌ Erreur détection: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=str(e))

