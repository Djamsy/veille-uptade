# =====================================================
#  backend/.env.example
#  Copier en backend/.env et remplir les vraies valeurs.
#  Ne JAMAIS committer backend/.env (cf. .gitignore).
# =====================================================

# --- Environnement -----------------------------------
ENVIRONMENT=development            # development | production
PORT=8000
TIMEZONE=America/Guadeloupe

# --- MongoDB -----------------------------------------
# NB : MONGO_URL est le nom canonique. MONGO_URI / MONGODB_URI / MONGODB_DB
# sont des alias lus par certains modules historiques (à fusionner — voir DUPLICATES.md).
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veille_media?retryWrites=true&w=majority
MONGO_URI=                         # alias historique de MONGO_URL
MONGODB_URI=                       # alias historique de MONGO_URL
DB_NAME=veille_media
MONGO_DB_NAME=veille_media         # alias historique de DB_NAME
MONGODB_DB=veille_media            # alias historique de DB_NAME
ARTICLES_COLLECTION=articles
NATIONAL_ARTICLES_COLLECTION=national_articles
TRANSCRIPTS_COLLECTION=transcripts
DIGEST_COLLECTION=digests

# --- Auth / JWT --------------------------------------
JWT_SECRET=change-me-to-a-32-char-random-string
PUBLICATION_BOT_TOKEN=
PUBLICATION_BOT_AUTHORIZED=
DIGEST_LOGO_PATH=                  # chemin vers le logo affiché dans les PDF digest

# --- CORS --------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://veille-uptade.example.com
CORS_ORIGIN_REGEX=                 # regex optionnelle pour les origins dynamiques

# --- LLM / IA ----------------------------------------
OPENAI_API_KEY=sk-...
MISTRAL_API_KEY=
DISABLE_GPT_SENTIMENT=false
FORCE_LOCAL_SENTIMENT=false
USE_GPT_FALLBACK=true
GPT_THRESHOLD=0.6
ENABLE_SENTIMENT_ANALYSIS=true
AI_CACHE_ENABLED=true
SENTIMENT_BATCH_SIZE=10
SENTIMENT_MAX_WORKERS=4
SENTIMENT_CACHE_LIMIT=10000

# --- Ollama (legacy, prévu pour suppression) ---------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Scraping / scheduler ----------------------------
RUN_SCHEDULER=true
RUN_SCRAPING_ON_START=false
FUSION_TIME_WINDOW_DAYS=3
GRAVITY_THRESHOLD=0.5
AFFAIR_GRAVITY_THRESHOLD=0.5
ATLAS_STORAGE_LIMIT_MB=512

# --- Apify (réseaux sociaux) -------------------------
# NB : APIFY_API_TOKEN est le nom canonique ; APIFY_TOKEN est un alias toléré (à supprimer après migration).
APIFY_API_TOKEN=apify_api_...
APIFY_TOKEN=                       # alias historique de APIFY_API_TOKEN

# --- Réseaux sociaux ---------------------------------
SOCIAL_NOAPI_MODE=true
SOCIAL_MAX_POSTS_PER_KEYWORD=20
SOCIAL_RATE_LIMIT_DELAY=2
SOCIAL_RSS_SOURCES=
COMMENT_TRACKING_DAYS=30

# Sources critiques (CSV de pages/comptes)
CRITICAL_FACEBOOK_PAGES=
CRITICAL_TIKTOK_ACCOUNTS=
CRITICAL_TWITTER_ACCOUNTS=
CRITICAL_YOUTUBE_CHANNELS=

# Comptes officiels CD971
CD971_FACEBOOK_URL=
CD971_INSTAGRAM_URL=
CD971_TIKTOK_URL=

# --- Facebook Graph API ------------------------------
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_NAME=

# --- Twitter / X -------------------------------------
TWITTER_BEARER_TOKEN=
NITTER_INSTANCES=

# --- YouTube -----------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_URLS=

# --- Telegram ----------------------------------------
# @BotFather pour le token, https://api.telegram.org/bot<TOKEN>/getUpdates pour le chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Buffer (publication réseaux) --------------------
BUFFER_ACCESS_TOKEN=
BUFFER_ORG_ID=

# --- Google / search ---------------------------------
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Cloudinary (médias) -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web push (notifications navigateur) -------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com

# --- Radio / transcription ---------------------------
RADIO_CONCURRENCY=2

# --- Météo -------------------------------------------
METEO_ALERT_LEVEL=yellow

# --- Redis (optionnel, cache distribué) --------------
REDIS_HOST=
REDIS_PORT=6379

# --- Bruit médiatique (BMG) --------------------------
ENABLE_MEDIA_NOISE=true

# --- Render (production) -----------------------------
RENDER_EXTERNAL_URL=
