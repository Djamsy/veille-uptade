MONGO_URL="mongodb+srv://djamalloiseau:<password>@cluster0.kae7vjm.mongodb.net/veille_media?retryWrites=true&w=majority"
# Cluster de secours (optionnel) : active la bascule automatique si le principal tombe.
# Même nom de base que le principal. Voir backend/db_failover.py.
MONGO_URL_FALLBACK=
ENVIRONMENT=development
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram — Obtenir via @BotFather et https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alertes e-mail Brevo (optionnel) — un e-mail par cycle de scraping regroupant les nouveaux articles
# L'expéditeur doit être vérifié dans Brevo (Expéditeurs, domaines et IP dédiées).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Veille Média 971
EMAIL_ALERT_TO=
# all (tous les articles) | relevant (gravité >= EMAIL_MIN_GRAVITY) | off
EMAIL_ARTICLE_ALERTS=all
EMAIL_MIN_GRAVITY=0.4
# Plafond d'e-mails/jour, destinataires compris (plan gratuit Brevo : 300/jour)
EMAIL_DAILY_LIMIT=250
# E-mail « service démarré » à chaque démarrage / déploiement (test Brevo). 0 pour le couper.
EMAIL_STARTUP_NOTIFY=1

# ── Publications pour validation (contenu chiffré, liens à jeton) ──────────
# Clé AES-256 (32 octets base64url). OBLIGATOIRE en production, sinon le module ne démarre pas.
# Générer : python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PUBLICATION_ENCRYPTION_KEY=
# Rotation : ancienne clé (déchiffrement seul) + numéro de version de la nouvelle
PUBLICATION_ENCRYPTION_KEY_OLD=
PUBLICATION_ENCRYPTION_KEY_VERSION=1
# Compte de service Google (JSON brut ou base64) partagé en Éditeur sur la feuille
GOOGLE_SERVICE_ACCOUNT_JSON=
PUBLICATION_SHEET_ID=
PUBLICATION_SHEET_TAB=
# URL publique du front pour fabriquer les liens /valider/<jeton>
PUBLICATION_VALIDATION_BASE_URL=https://veille-media.example
PUBLICATION_VALIDATION_TTL_HOURS=72
# Destinataires des liens de validation (défaut : EMAIL_ALERT_TO) + Telegram (TELEGRAM_BOT_TOKEN/CHAT_ID)
PUBLICATION_VALIDATION_NOTIFY_EMAILS=
PUBLICATION_VALIDATION_NOTIFY_TELEGRAM=1
