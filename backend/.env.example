MONGO_URL="mongodb+srv://djamalloiseau:<password>@cluster0.kae7vjm.mongodb.net/veille_media?retryWrites=true&w=majority"
# Cluster de secours (optionnel) : active la bascule automatique si le principal tombe.
# Même nom de base que le principal. Voir backend/db_failover.py.
MONGO_URL_FALLBACK=
ENVIRONMENT=development
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram — Obtenir via @BotFather et https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alertes e-mail Brevo (optionnel) — un e-mail par cycle de scraping regroupant les nouveaux articles
# L'expéditeur doit être vérifié dans Brevo (Expéditeurs, domaines et IP dédiées).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Veille Média 971
EMAIL_ALERT_TO=
# all (tous les articles) | relevant (gravité >= EMAIL_MIN_GRAVITY) | off
EMAIL_ARTICLE_ALERTS=all
EMAIL_MIN_GRAVITY=0.4
# Plafond d'e-mails/jour, destinataires compris (plan gratuit Brevo : 300/jour)
EMAIL_DAILY_LIMIT=250
